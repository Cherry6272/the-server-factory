# ─────────────────────────────────────────────────────────────
# Copy to .env and fill in. Never put real values in THIS file —
# it is committed to the repo.
#
#   cp .env.example .env
#
# Production values are set in Vercel → Settings → Environment Variables,
# not here.
# ─────────────────────────────────────────────────────────────

# ── Database (REQUIRED) ──────────────────────────────────────
# Postgres connection string. On Neon/Supabase use the POOLED connection
# string — Vercel's serverless functions open a connection per invocation
# and will exhaust a direct one. Usually needs ?sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# ── Auth (REQUIRED) ──────────────────────────────────────────
# Generate with: openssl rand -base64 32
# Use a DIFFERENT value per environment. Changing it logs everyone out.
AUTH_SECRET=""

# REQUIRED on Netlify (and anything that isn't Vercel or Cloudflare Pages).
#
# NextAuth only trusts the incoming Host header when one of AUTH_URL,
# AUTH_TRUST_HOST, VERCEL or CF_PAGES is present. Netlify sets none of them,
# so without this every sign-in fails with UntrustedHost in production.
# Setting AUTH_URL also pins the canonical origin for auth callbacks, which
# matters when both the apex and www resolve.
AUTH_URL="https://www.example.com"

# ── Site identity (REQUIRED) ─────────────────────────────────
# Drives sitemap.xml, robots.txt, canonical + OG tags and JSON-LD.
# No trailing slash. Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL="https://example.com"

# ── First admin user — LOCAL ONLY ────────────────────────────
# Read exclusively by `npm run db:seed`, which is run by hand. The build is
# `prisma generate && next build` and never seeds, so these are not needed on
# the host.
#
# Do NOT set these in Netlify/Vercel:
#   - nothing there reads them, so ADMIN_PASSWORD would just be sitting in an
#     environment that has no use for it
#   - Netlify's secrets scanner fails the build when it finds ADMIN_EMAIL's
#     value in output, which it will, because the same address is the public
#     contact email printed on every page
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# ── Cloudinary image uploads (REQUIRED for admin image upload) ──
# Dashboard → Settings → API Keys. Without these the admin upload button
# returns a clear "not configured" error; the rest of the site is unaffected.
# The secret signs upload requests — never expose it to the browser.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Google sign-in (OPTIONAL) ────────────────────────────────
# Leave unset to disable the "Sign in with Google" button. The provider is
# only registered when BOTH id and secret are present.
# Authorised redirect URI: https://YOUR_DOMAIN/api/auth/callback/google
# NEXT_PUBLIC_GOOGLE_ENABLED="true"
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# ── Email Notifications (Titan Email SMTP) ────────────────────────
# Used to deliver customer order receipts, enquiry notifications, and admin alerts.
# When unset, orders and enquiries are still saved reliably to the database, and
# the system safely skips sending without crashing or returning fake success.
#
# Titan Email SMTP Settings (Recommended: Port 465 with SSL):
#   SMTP_HOST="smtp.titan.email"
#   SMTP_PORT="465"
#   SMTP_SECURE="true"
#   SMTP_USER="sales@theserverfactory.com"
#   SMTP_PASSWORD="YOUR_TITAN_EMAIL_PASSWORD"  (or Titan App Password if 2FA enabled)
#   EMAIL_FROM="The Server Factory <sales@theserverfactory.com>"
#   ADMIN_NOTIFICATION_EMAIL="sales@theserverfactory.com"
SMTP_HOST="smtp.titan.email"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="sales@theserverfactory.com"
SMTP_PASSWORD=""
EMAIL_FROM="The Server Factory <sales@theserverfactory.com>"
ADMIN_NOTIFICATION_EMAIL="sales@theserverfactory.com"

